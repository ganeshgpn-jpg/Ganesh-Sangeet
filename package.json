{
  "name": "ganesh-sangeet-yantra",
  "version": "1.0.0",
  "private": true,
  "description": "Shree Ganesh Sangeet Yantra - Android APK (Capacitor)",
  "scripts": {
    "bundle": "esbuild native/entry.js --bundle --minify --format=iife --outfile=www/native-bundle.js",
    "prepare-www": "node scripts/prepare-www.js",
    "android:add": "cap add android && node scripts/patch-android.js && cap sync android",
    "android:sync": "node scripts/patch-android.js && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@jofr/capacitor-media-session": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "esbuild": "^0.24.0"
  }
}
